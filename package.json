{
  "name": "study-english",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "predev": "pnpm run generate:audio-lookup",
    "dev": "vite",
    "download:audio": "node scripts/download-audio.mjs",
    "normalize:audio": "node scripts/normalize-audio-extensions.mjs",
    "prepare:examples": "node scripts/generate-examples.mjs --prepare",
    "prepare:example-sources": "node scripts/prepare-example-sources.mjs",
    "generate:examples": "node scripts/generate-examples.mjs",
    "start:example-generation": "node scripts/start-example-generation.mjs",
    "apply:examples": "node scripts/apply-examples.mjs --write",
    "generate:search-index": "node scripts/generate-search-index.mjs",
    "generate:audio-lookup": "node scripts/generate-audio-lookup.mjs",
    "prebuild": "pnpm run generate:search-index && pnpm run generate:audio-lookup",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.5"
  }
}
